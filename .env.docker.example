# Docker Hub namespace or username used by `docker compose push`.
DOCKERHUB_USERNAME=ioncrade
IMAGE_TAG=latest

# Public browser-accessible addresses. Rebuild the frontend after changing
# NEXT_PUBLIC_API_URL because Next.js embeds public variables at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Optional Hugging Face token for faster/private model downloads.
HF_TOKEN=

# Backend runtime tuning.
FRAMESEG_PRELOAD_MODEL=true
FRAMESEG_OFFLOAD_STATE_TO_CPU=false
FRAMESEG_OUTPUT_CODEC=prores_4444
